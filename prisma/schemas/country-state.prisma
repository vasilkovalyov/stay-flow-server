model CountryState {
  id                      Int           @id @default(autoincrement())

  name                    String        

  cities                  City[]

  countryId               Int?          @map("country_id")
  country                 Country?      @relation(fields: [countryId], references: [id])

  profiles                UserProfile[]

  @@index([countryId])
  @@map("country-states")
}